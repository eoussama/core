{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test \"test/**/*.test.ts\""
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.type.ts",
    "!src/**/index.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  }
}
