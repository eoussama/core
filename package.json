{
  "name": "@eoussama/core",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "description": "Lightweight, zero-dependency TypeScript utilities for Node.js and browsers.",
  "author": "eoussama",
  "license": "MIT",
  "funding": "https://github.com/sponsors/eoussama",
  "homepage": "https://ouss.es/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoussama/core.git"
  },
  "bugs": {
    "url": "https://github.com/eoussama/core/issues"
  },
  "keywords": [
    "core",
    "utils",
    "utilities",
    "typescript",
    "try-catch",
    "type-guards",
    "retry",
    "timeout"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "pnpm typecheck && pnpm build && pnpm test",
    "build": "pnpm lint && tsdown",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "dx lint",
    "fix": "dx fix",
    "doc": "typedoc"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.1.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
